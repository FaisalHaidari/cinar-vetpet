datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  email     String   @unique
  password  String
  phone     String?
  avatar    String?
  cartItems CartItem[]
  addresses Address[]
  orders    Order[]
}

model Urun {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(255)
  price          Float
  description    String?   @db.Text
  image          String?   @db.LongText
  category       String
  stock          Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orderItems     OrderItem[]
  cartItems      CartItem[]
}

model CartItem {
  id       Int @id @default(autoincrement())
  userId   Int
  urunId   Int
  quantity Int @default(1)
  user     User @relation(fields: [userId], references: [id])
  urun     Urun @relation(fields: [urunId], references: [id])

  @@unique([userId, urunId])
}

model Address {
  id          Int     @id @default(autoincrement())
  userId      Int
  street      String
  buildingNo  String
  floor       String?
  apartmentNo String
  addressNote String?
  phoneNumber String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  user        User    @relation(fields: [userId], references: [id])
  orders      Order[]

  @@unique([userId, id])
}

model Order {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    Int
  addressId Int
  user      User     @relation(fields: [userId], references: [id])
  address   Address  @relation(fields: [addressId], references: [id])
  orderItems OrderItem[]
  totalAmount Float?
  status      OrderStatus @default(PENDING)
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  PROCESSING
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  urunId    Int
  quantity  Int
  price     Float
  order     Order    @relation(fields: [orderId], references: [id])
  urun      Urun     @relation(fields: [urunId], references: [id])

  @@unique([orderId, urunId])
} 